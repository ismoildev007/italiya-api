APP_NAME="Italiya Akademiyasi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=uz
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=uz_UZ

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=maktab
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ---------------------------------------------------------------------------
# O'quv markazi (white-label) sozlamalari
# Har bir markaz alohida serverga, alohida bazaga o'rnatiladi.
# ---------------------------------------------------------------------------
SCHOOL_ID=1
SCHOOL_NAME="Italiya Akademiyasi"
SCHOOL_SHORT_NAME="Italiya"
SCHOOL_LOGO=/images/logo.png
SCHOOL_PHONE="+998 71 000 00 00"
SCHOOL_EMAIL=
SCHOOL_ADDRESS="Toshkent"
SCHOOL_WEBSITE=
SCHOOL_DIRECTOR="PhD Shodiyeva Umida"
SCHOOL_TELEGRAM=https://t.me/RaniyaK2
SCHOOL_CURRENCY=UZS
SCHOOL_TIMEZONE=Asia/Tashkent
SCHOOL_INVOICE_DAY=1

# ---------------------------------------------------------------------------
# Akademiya (config/academy.php)
# ---------------------------------------------------------------------------
ACADEMY_TARGET_LANGUAGE=it
ACADEMY_DEFAULT_TRANSLATION=uz
ACADEMY_UNIT_MAX_PLAYS=3          # darslik audiosi necha marta tinglanadi
ACADEMY_PASS_PERCENT=60
CERTIFICATE_AVAILABLE_FROM_DAY=25 # sertifikat oyning shu sanasidan keyin, oyiga 1 marta
CERTIFICATE_MIN_ATTEMPTS=1
CERTIFICATE_SIGNER="PhD Shodiyeva Umida"
ACADEMY_MONTHLY_REPORT_DAY=28     # oylik tahlil ota-onaga yuboriladigan kun
ACADEMY_DEBT_REMINDER_DAYS=5,15,25

# ---------------------------------------------------------------------------
# AI provayderlar
#   AI_GENERATOR — test/darslik/lug'at generatsiyasi (gemini | openai | anthropic)
#   AI_EVALUATOR — writing/speaking tahlili (gemini tavsiya etiladi)
#   STT/TTS      — OpenAI (ovozni o'qish va listening audio)
# ---------------------------------------------------------------------------
AI_GENERATOR=gemini
AI_EVALUATOR=gemini
AI_STT=openai
AI_TTS=openai

OPENAI_API_KEY=
# Bepul OpenAI-mos API (masalan Groq: https://api.groq.com/openai/v1, OpenRouter: https://openrouter.ai/api/v1)
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
OPENAI_STT_MODEL=gpt-4o-mini-transcribe
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=alloy

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------------------------------------------------------------------------
# Telegram botlar
#   TELEGRAM_BOT_TOKEN         — ota-onalar boti (qarzdorlik, oylik hisobot, baho)
#   TELEGRAM_STUDENT_BOT_TOKEN — o'quvchilar boti (faqat variantli testlar)
#   Webhook: php artisan telegram:set-webhook https://domen.uz
# ---------------------------------------------------------------------------
TELEGRAM_BOT_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_STUDENT_BOT_TOKEN=
TELEGRAM_STUDENT_WEBHOOK_SECRET=

# --- WebSocket (Laravel Reverb) — duel o'yini uchun ---
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=italiya
REVERB_APP_KEY=italiya-key
REVERB_APP_SECRET=italiya-secret
REVERB_HOST=127.0.0.1
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080
DUEL_ENABLED=true

# --- Firebase Cloud Messaging (brauzer push) ---
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS=storage/app/firebase.json
